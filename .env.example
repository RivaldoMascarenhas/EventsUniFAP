# ==============================================================================
# UNIFAP SORTEIOS - VARIÁVEIS DE AMBIENTE (PRODUÇÃO & DESENVOLVIMENTO)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BANCO DE DADOS (SUPABASE POSTGRESQL)
# ------------------------------------------------------------------------------
# No Supabase Dashboard: Project Settings -> Database -> Connection string
# 
# DATABASE_URL (Transaction Pooler - porta 6543, recomendado para Serverless/Vercel):
DATABASE_URL="postgresql://postgres.[SEU-PROJECT-REF]:[SUA-SENHA]@aws-0-[SUA-REGIAO].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL (Direct Connection - porta 5432, usado pelo Prisma para migrations e schema push):
DIRECT_URL="postgresql://postgres.[SEU-PROJECT-REF]:[SUA-SENHA]@aws-0-[SUA-REGIAO].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. AUTENTICAÇÃO E SEGURANÇA (NextAuth v4)
# ------------------------------------------------------------------------------
# Gere um segredo seguro executando no terminal: openssl rand -base64 32
NEXTAUTH_SECRET="gere-uma-chave-secreta-aleatoria-de-32-caracteres"
AUTH_SECRET="gere-uma-chave-secreta-aleatoria-de-32-caracteres"

# URL da aplicação em Produção (Vercel) ou Local:
NEXTAUTH_URL="https://seu-projeto.vercel.app"
NEXT_PUBLIC_APP_URL="https://seu-projeto.vercel.app"

# ------------------------------------------------------------------------------
# 3. ARMAZENAMENTO E UPLOADS (SUPABASE STORAGE)
# ------------------------------------------------------------------------------
# No Supabase Dashboard: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://[SEU-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Nome do Bucket de Storage no Supabase (crie como Público no painel de Storage):
SUPABASE_STORAGE_BUCKET="sorteios"

# Fallback local (usado apenas em ambiente de desenvolvimento local sem Supabase):
STORAGE_PROVIDER="supabase"
UPLOAD_DIR="./public/uploads"
